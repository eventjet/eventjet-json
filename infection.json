{
    "staticAnalysisTool":"phpstan",
    "timeout": 60,
    "testFrameworkOptions": "--enforce-time-limit --default-time-limit=5 --stop-on-risky",
    "source": {
        "directories": [
            "src"
        ]
    },
    "logs": {
        "text": "infection-log.txt"
    },
    "minMsi": 100,
    "minCoveredMsi": 100,
    "mutators": {
        "@default": true,
        "global-ignoreSourceCodeByRegex": [
            "assert\\(.+\\);"
        ]
    }
}
