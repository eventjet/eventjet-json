{
    "name": "eventjet/json",
    "description": "Type-safe JSON decoding",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-tokenizer": "*"
    },
    "require-dev": {
        "carthage-software/mago": "^1.50",
        "infection/infection": "^0.35.5",
        "maglnet/composer-require-checker": "^4.20",
        "phpbench/phpbench": "^1.7",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.5",
        "psalm/plugin-phpunit": "^0.19.7",
        "vimeo/psalm": "^6.19"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Eventjet\\Json\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eventjet\\Json\\Benchmark\\": "benchmarks",
            "Eventjet\\Json\\Test\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "benchmark": "phpbench run --report=aggregate",
        "check": [
            "@check-deps",
            "@cs-check",
            "@psalm",
            "@phpstan",
            "@mago",
            "@phpunit",
            "@infection"
        ],
        "check-deps": "composer-require-checker",
        "cs": "mago format",
        "cs-check": "mago format --check",
        "infection": "infection -jmax --with-uncovered",
        "infection-diff": "infection -jmax --git-diff-lines --min-msi=100 --min-covered-msi=100 --ignore-msi-with-no-mutations",
        "mago": [
            "@mago-lint",
            "@mago-analyze"
        ],
        "mago-analyze": "mago analyze",
        "mago-lint": "mago lint",
        "phpstan": "phpstan analyze",
        "phpunit": "phpunit",
        "psalm": "psalm"
    }
}
