{
    "name": "eventjet/json",
    "type": "library",
    "description": "Type-safe JSON encoding and decoding",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*"
    },
    "require-dev": {
        "eventjet/coding-standard": "^3.18",
        "infection/infection": "^0.31.4",
        "maglnet/composer-require-checker": "^4.16",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^12.4",
        "psalm/plugin-phpunit": "^0.19.5",
        "vimeo/psalm": "^6.13"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Eventjet\\Json\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Eventjet\\Test\\Unit\\Json\\": "tests/unit"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "check": [
            "@check-deps",
            "@cs-check",
            "@psalm",
            "@phpstan",
            "@phpunit",
            "@infection"
        ],
        "check-deps": "vendor/bin/composer-require-checker",
        "cs-check": "php-cs-fixer fix --dry-run",
        "cs-fix": "php-cs-fixer fix",
        "infection": "vendor/bin/infection -jmax",
        "phpstan": "vendor/bin/phpstan",
        "phpunit": "vendor/bin/phpunit",
        "psalm": "vendor/bin/psalm"
    }
}
