[
    {
        "description": "Unicode property names that ECMA-262 knows",
        "schema": {"format": "regex"},
        "tests": [
            {"description": "a binary property is valid", "data": "\\p{Alphabetic}", "valid": true},
            {"description": "Assigned is valid", "data": "\\P{Assigned}", "valid": true},
            {"description": "a property that PCRE doesn't know is valid", "data": "\\p{Changes_When_NFKC_Casefolded}", "valid": true},
            {"description": "a script is valid", "data": "\\p{Script=Greek}", "valid": true},
            {"description": "a script alias is valid", "data": "\\p{sc=Grek}", "valid": true},
            {"description": "a script extension is valid", "data": "\\p{Script_Extensions=Latin}", "valid": true},
            {"description": "a script extension alias is valid", "data": "\\p{scx=Latn}", "valid": true},
            {"description": "an unknown property is invalid", "data": "\\p{Foo}", "valid": false},
            {"description": "a general category in the wrong case is invalid", "data": "\\p{lu}", "valid": false},
            {"description": "a script without its property name is invalid", "data": "\\p{Greek}", "valid": false},
            {"description": "a property that only PCRE knows is invalid", "data": "\\p{Xan}", "valid": false},
            {"description": "a script in the wrong case is invalid", "data": "\\p{Script=greek}", "valid": false},
            {"description": "an unknown script is invalid", "data": "\\p{Script_Extensions=Foo}", "valid": false}
        ]
    }
]
