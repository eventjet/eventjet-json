[
    {
        "description": "a relative root $id with a path is the base of references",
        "schema": {
            "$id": "a/b.json",
            "definitions": {"x": {"type": "string"}},
            "allOf": [{"$ref": "#/definitions/x"}]
        },
        "tests": [
            {"description": "a string is valid", "data": "x", "valid": true},
            {"description": "a number is invalid", "data": 1, "valid": false}
        ]
    },
    {
        "description": "the fragment of a root $id names the root",
        "schema": {
            "$id": "a/b.json#root",
            "type": "object",
            "properties": {"child": {"$ref": "#root"}}
        },
        "tests": [
            {"description": "a nested object is valid", "data": {"child": {"child": {}}}, "valid": true},
            {"description": "a nested number is invalid", "data": {"child": {"child": 1}}, "valid": false}
        ]
    }
]
