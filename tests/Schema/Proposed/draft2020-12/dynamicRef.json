[
    {
        "description": "$dynamicRef alongside $ref",
        "schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$ref": "#/$defs/integer",
            "$dynamicRef": "#atLeastFive",
            "$defs": {
                "integer": {
                    "type": "integer"
                },
                "atLeastFive": {
                    "$dynamicAnchor": "atLeastFive",
                    "minimum": 5
                }
            }
        },
        "tests": [
            {
                "description": "a value valid against both is valid",
                "data": 6,
                "valid": true
            },
            {
                "description": "a value valid only against $ref is invalid",
                "data": 1,
                "valid": false
            }
        ]
    }
]
