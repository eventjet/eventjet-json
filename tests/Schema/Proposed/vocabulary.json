{
    "description": "vocabulary validation",
    "tests": [
        {
            "description": "ignore an unrecognized optional vocabulary listed before the known ones",
            "compatibility": "=2019",
            "schema": {
                "$schema": "http://localhost:1234/draft2019-09/metaschema-unknown-vocabulary-first.json",
                "type": "number"
            },
            "externalSchemas": {
                "http://localhost:1234/draft2019-09/metaschema-unknown-vocabulary-first.json": {
                    "$schema": "https://json-schema.org/draft/2019-09/schema",
                    "$id": "http://localhost:1234/draft2019-09/metaschema-unknown-vocabulary-first.json",
                    "$vocabulary": {
                        "http://localhost:1234/draft/2019-09/vocab/custom": false,
                        "https://json-schema.org/draft/2019-09/vocab/core": true,
                        "https://json-schema.org/draft/2019-09/vocab/validation": true
                    },
                    "$recursiveAnchor": true,
                    "allOf": [
                        {
                            "$ref": "https://json-schema.org/draft/2019-09/meta/core"
                        },
                        {
                            "$ref": "https://json-schema.org/draft/2019-09/meta/validation"
                        }
                    ]
                }
            },
            "tests": [
                {
                    "description": "string value",
                    "data": "foobar",
                    "valid": false
                },
                {
                    "description": "number value",
                    "data": 20,
                    "valid": true
                }
            ]
        },
        {
            "description": "ignore an unrecognized optional vocabulary listed before the known ones",
            "compatibility": "=2020",
            "schema": {
                "$schema": "http://localhost:1234/draft2020-12/metaschema-unknown-vocabulary-first.json",
                "type": "number"
            },
            "externalSchemas": {
                "http://localhost:1234/draft2020-12/metaschema-unknown-vocabulary-first.json": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "$id": "http://localhost:1234/draft2020-12/metaschema-unknown-vocabulary-first.json",
                    "$vocabulary": {
                        "http://localhost:1234/draft/2020-12/vocab/custom": false,
                        "https://json-schema.org/draft/2020-12/vocab/core": true,
                        "https://json-schema.org/draft/2020-12/vocab/validation": true
                    },
                    "$dynamicAnchor": "meta",
                    "allOf": [
                        {
                            "$ref": "https://json-schema.org/draft/2020-12/meta/core"
                        },
                        {
                            "$ref": "https://json-schema.org/draft/2020-12/meta/validation"
                        }
                    ]
                }
            },
            "tests": [
                {
                    "description": "string value",
                    "data": "foobar",
                    "valid": false
                },
                {
                    "description": "number value",
                    "data": 20,
                    "valid": true
                }
            ]
        },
        {
            "description": "unevaluatedProperties belongs to the applicator vocabulary",
            "compatibility": "=2019",
            "comment": "2019-09 has no separate unevaluated vocabulary",
            "schema": {
                "$schema": "http://localhost:1234/draft2019-09/metaschema-applicator-only.json",
                "unevaluatedProperties": false
            },
            "externalSchemas": {
                "http://localhost:1234/draft2019-09/metaschema-applicator-only.json": {
                    "$schema": "https://json-schema.org/draft/2019-09/schema",
                    "$id": "http://localhost:1234/draft2019-09/metaschema-applicator-only.json",
                    "$vocabulary": {
                        "https://json-schema.org/draft/2019-09/vocab/core": true,
                        "https://json-schema.org/draft/2019-09/vocab/applicator": true
                    },
                    "$recursiveAnchor": true,
                    "allOf": [
                        {
                            "$ref": "https://json-schema.org/draft/2019-09/meta/applicator"
                        },
                        {
                            "$ref": "https://json-schema.org/draft/2019-09/meta/core"
                        }
                    ]
                }
            },
            "tests": [
                {
                    "description": "an empty object is valid",
                    "data": {},
                    "valid": true
                },
                {
                    "description": "an unevaluated property is invalid",
                    "data": {
                        "foo": 1
                    },
                    "valid": false
                }
            ]
        },
        {
            "description": "format assertion turned on with a custom metaschema with the format-annotation vocabulary",
            "compatibility": "=2020",
            "tags": [
                "format-assertion"
            ],
            "schema": {
                "$schema": "http://localhost:1234/draft2020-12/metaschema-format-annotation.json",
                "format": "ipv4"
            },
            "externalSchemas": {
                "http://localhost:1234/draft2020-12/metaschema-format-annotation.json": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "$id": "http://localhost:1234/draft2020-12/metaschema-format-annotation.json",
                    "$vocabulary": {
                        "https://json-schema.org/draft/2020-12/vocab/core": true,
                        "https://json-schema.org/draft/2020-12/vocab/format-annotation": true
                    },
                    "$dynamicAnchor": "meta",
                    "allOf": [
                        {
                            "$ref": "https://json-schema.org/draft/2020-12/meta/core"
                        },
                        {
                            "$ref": "https://json-schema.org/draft/2020-12/meta/format-annotation"
                        }
                    ]
                }
            },
            "tests": [
                {
                    "description": "a valid string is valid",
                    "data": "127.0.0.1",
                    "valid": true
                },
                {
                    "description": "an invalid string is invalid",
                    "data": "not-an-ipv4",
                    "valid": false
                }
            ]
        },
        {
            "description": "format annotation with a custom metaschema with the format-annotation vocabulary",
            "compatibility": "=2020",
            "tags": [
                "format-annotation"
            ],
            "schema": {
                "$schema": "http://localhost:1234/draft2020-12/metaschema-format-annotation.json",
                "format": "ipv4"
            },
            "externalSchemas": {
                "http://localhost:1234/draft2020-12/metaschema-format-annotation.json": {
                    "$schema": "https://json-schema.org/draft/2020-12/schema",
                    "$id": "http://localhost:1234/draft2020-12/metaschema-format-annotation.json",
                    "$vocabulary": {
                        "https://json-schema.org/draft/2020-12/vocab/core": true,
                        "https://json-schema.org/draft/2020-12/vocab/format-annotation": true
                    },
                    "$dynamicAnchor": "meta",
                    "allOf": [
                        {
                            "$ref": "https://json-schema.org/draft/2020-12/meta/core"
                        },
                        {
                            "$ref": "https://json-schema.org/draft/2020-12/meta/format-annotation"
                        }
                    ]
                }
            },
            "tests": [
                {
                    "description": "an invalid string is only an annotation",
                    "data": "not-an-ipv4",
                    "valid": true
                }
            ]
        }
    ]
}
