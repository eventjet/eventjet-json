[
    {
        "description": "e-mail address literals",
        "schema": {
            "format": "email"
        },
        "tests": [
            {
                "description": "a full IPv6 address literal is valid",
                "data": "joe.bloggs@[IPv6:1:2:3:4:5:6:7:8]",
                "valid": true
            },
            {
                "description": "a letter after an address literal is invalid",
                "data": "joe.bloggs@[127.0.0.1]x",
                "valid": false
            },
            {
                "description": "an address literal followed by a line feed is invalid",
                "data": "joe.bloggs@[127.0.0.1]\n",
                "valid": false
            }
        ]
    }
]
