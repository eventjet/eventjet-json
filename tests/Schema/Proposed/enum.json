{
    "description": "enum validation",
    "tests": [
        {
            "description": "enum alongside type",
            "compatibility": "4,<=2020",
            "schema": {
                "type": "integer",
                "enum": [
                    1,
                    2
                ]
            },
            "tests": [
                {
                    "description": "a listed integer is valid",
                    "data": 1,
                    "valid": true
                },
                {
                    "description": "an unlisted integer is invalid",
                    "data": 3,
                    "valid": false
                }
            ]
        }
    ]
}
