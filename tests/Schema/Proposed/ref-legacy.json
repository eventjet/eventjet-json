                "id": "http://example.com",
                "allOf": [
                    {
                        "$ref": "foo.json"
                    }
                ],
                "definitions": {
                    "target": {
                        "id": "http://example.com/foo.json",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        },
