{
    "description": "optional/ref",
    "tests": [
        {
            "description": "$ref with an uppercase scheme",
            "compatibility": "2019,<=2020",
            "comment": "RFC 3986 3.1: schemes are case-insensitive; RFC 3986 6.2.2.1 recommends normalizing them to lowercase",
            "schema": {
                "$id": "http://example.com/a.json",
                "$ref": "HTTP://example.com/b.json",
                "$defs": {
                    "target": {
                        "$id": "http://example.com/b.json",
                        "type": "string"
                    }
                }
            },
            "tests": [
                {
                    "description": "a string is valid",
                    "data": "foo",
                    "valid": true
                },
                {
                    "description": "a non-string is invalid",
                    "data": 1,
                    "valid": false
                }
            ]
        }
    ]
}
