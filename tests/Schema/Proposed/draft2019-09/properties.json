[
    {
        "description": "properties with a numeric-looking name",
        "schema": {
            "$schema": "https://json-schema.org/draft/2019-09/schema",
            "properties": {
                "1": {
                    "type": "string"
                }
            }
        },
        "tests": [
            {
                "description": "a string value is valid",
                "data": {
                    "1": "foo"
                },
                "valid": true
            },
            {
                "description": "a non-string value is invalid",
                "data": {
                    "1": 1
                },
                "valid": false
            }
        ]
    }
]
