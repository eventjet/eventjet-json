{
    "runner.bootstrap": "vendor/autoload.php",
    "runner.path": "benchmarks",
    "runner.php_config": {
        "pcov.enabled": "0",
        "opcache.enable_cli": "1",
        "opcache.enable": "1",
        "opcache.jit": "0",
        "opcache.jit_buffer_size": "0",
        "opcache.file_update_protection": "0",
        "opcache.file_cache": "",
        "opcache.save_comments": "1",
        "xdebug.mode": "off"
    },
    "core.profiles": {
        "opcache-off": {
            "runner.php_config": {
                "opcache.enable_cli": "0"
            }
        }
    }
}
